# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不要提交真实密钥）
SMS_PROVIDER=console
SMS_DEBUG=1

# ---- 阿里云短信（SMS_PROVIDER=aliyun 时填写）----
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_REGION=cn-hangzhou
ALIYUN_SMS_PARAM_KEY=code

# ---- 下载前留手机号 ----
LEAD_REQUIRED=1

# ---- 视觉模型（可选，OpenAI 兼容接口）----
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_MAX_ROUNDS=3

# ---- 其它 ----
# DATABASE_URL=sqlite:///var/app.db
# MAX_JOBS=2
# MAX_UPLOAD_MB=30
# SESSION_DAYS=30
# COOKIE_SECURE=0
